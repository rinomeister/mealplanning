// Prisma schema for the meal planning PWA.
// Provider: PostgreSQL (Coolify-managed in production).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String  @id @default(cuid())
  email         String  @unique
  passwordHash  String
  name          String?
  heightCm      Float?
  targetKcal    Int?
  targetProtein Int?
  targetFat     Int?
  targetCarbs   Int?
  targetSugar   Int?
  targetFiber   Int?
  units         Units   @default(METRIC)
  // Shopping-list aisles in store order: [{ key, label }]. Null = the defaults.
  // "Other" is never stored; it is always last.
  aisleOrder    Json?

  meals            Meal[]
  tags             Tag[]
  planEntries      PlanEntry[]
  bodyweights      BodyweightLog[]
  shoppingChecks   ShoppingCheck[]
  shoppingAisles   ShoppingAisle[]
  shoppingExtras   ShoppingExtra[]
  favoriteProducts ProductFavorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Meal {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  prepSteps    String? // free text / step list (optional)
  servingLabel String? // describes the 1-serving baseline, e.g. "1 bowl"
  serves       Float   @default(1) // how many servings the whole recipe yields
  // Weight of the whole cooked batch, when weighed. Lets a meal be logged by
  // grams eaten: servings = grams × serves / cookedGrams.
  cookedGrams  Float?
  favorite     Boolean @default(false)
  // Per-serving macros. Either typed in by hand or computed from scanned
  // ingredients (sum ÷ serves); `macrosManual` records which, so edits restore
  // the right mode.
  macrosManual Boolean @default(false)
  kcal         Float?
  protein      Float? // grams
  fat          Float?
  carbs        Float?
  sugar        Float?
  fiber        Float?

  ingredients Ingredient[]
  tags        MealTag[]
  planEntries PlanEntry[]
  share       MealShare?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Ingredient {
  id       String  @id @default(cuid())
  mealId   String
  meal     Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  name     String // required
  qty      Float? // optional (hybrid); grams when scanned from a barcode
  unit     String? // optional: ml, g, tbsp, pcs...
  note     String?
  position Int     @default(0)
  // Set when the ingredient was added by scanning a product. Macros are stored
  // per 100 g/ml; the ingredient's contribution is macros × qty/100.
  barcode  String?
  kcal     Float?
  protein  Float?
  fat      Float?
  carbs    Float?
  sugar    Float?
  fiber    Float?

  @@index([mealId])
}

model Tag {
  id     String    @id @default(cuid())
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  color  String?
  meals  MealTag[]

  @@unique([userId, name])
  @@index([userId])
}

model MealTag {
  mealId String
  tagId  String
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mealId, tagId])
  @@index([tagId])
}

// A day+slot entry. References a prebuilt meal (scaled by `servings`), a product
// (scaled by `grams`), or neither — a "quick add" of typed-in macros with a
// `label` (scaled by `servings`, normally 1). At most one of mealId/productId is
// set — enforced in the server actions, not at the DB level.
//
// The entry carries its own copy of the macros (per serving for meals and quick
// adds, per 100 g for products), so editing a meal or product later never
// rewrites days that already happened. Edits still flow into today and future
// days — see refreshUpcomingEntries in src/lib/entries.ts.
model PlanEntry {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime    @db.Date
  slot      Slot
  mealId    String?
  meal      Meal?       @relation(fields: [mealId], references: [id], onDelete: Restrict)
  productId String?
  product   Product?    @relation(fields: [productId], references: [id], onDelete: Restrict)
  servings  Float       @default(1) // used for meal entries
  // Product entries: grams eaten (the scale). Meal entries: grams eaten from a
  // weighed batch, for display only — servings stays the scale.
  grams     Float?
  status    EntryStatus @default(PLANNED)
  position  Int         @default(0)
  label     String? // name of a quick-add entry
  kcal      Float?
  protein   Float?
  fat       Float?
  carbs     Float?
  sugar     Float?
  fiber     Float?
  createdAt DateTime    @default(now())

  @@index([userId, date])
  @@index([mealId])
  @@index([productId])
}

// App-wide cache of scanned products, keyed by barcode. Macros are stored per
// 100 g/ml (canonical). Populated from Open Food Facts on first log and
// overridable by users (source flips to "user" once hand-edited).
model Product {
  id           String  @id @default(cuid())
  // Null for hand-entered foods: butcher's meat, loose produce, anything whose
  // packaging is long gone. Postgres allows many NULLs under a unique index, so
  // barcoded products still can't collide.
  barcode      String? @unique
  name         String
  brand        String?
  servingLabel String? // free text e.g. "30 g"
  servingGrams Float? // parsed numeric serving for the "1 serving" shortcut
  kcal         Float? // all per 100 g/ml
  protein      Float?
  fat          Float?
  carbs        Float?
  sugar        Float?
  fiber        Float?
  source       String  @default("openfoodfacts") // "user" once hand-edited

  planEntries PlanEntry[]
  portions    ProductPortion[]
  favoritedBy ProductFavorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Named portion sizes for a product ("1 slice" = 25 g), on top of servingGrams.
// Shared, like the products themselves.
model ProductPortion {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  grams     Float
  position  Int     @default(0)

  @@index([productId])
}

// A share code for a meal. Anyone signed in with the code can preview the meal
// and import their own independent copy. One code per meal; deleting the row
// (or the meal) stops sharing.
model MealShare {
  id        String   @id @default(cuid())
  code      String   @unique
  mealId    String   @unique
  meal      Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  imports   Int      @default(0)
  createdAt DateTime @default(now())
}

// A product starred by one user. Products are shared; favorites are not.
model ProductFavorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
  @@index([productId])
}

model BodyweightLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg   Float
  recordedAt DateTime @db.Date
  note       String?
  createdAt  DateTime @default(now())

  @@unique([userId, recordedAt])
  @@index([userId, recordedAt])
}

// Persisted state for the dynamically-computed shopping list, keyed by
// normalized "name|unit" so it survives plan changes. Either bought on this trip
// (checked; cleared by "Clear checked") or already at home (atHome; kept until
// unmarked, so staples like salt stay off the list).
model ShoppingCheck {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemKey   String
  checked   Boolean  @default(true)
  atHome    Boolean  @default(false)
  checkedAt DateTime @default(now())

  @@unique([userId, itemKey])
  @@index([userId])
}

// A user's choice of aisle for a shopping item (by lower-cased name),
// overriding the keyword guess in src/lib/aisles.ts.
model ShoppingAisle {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  aisle  String

  @@unique([userId, name])
}

// Something on the shopping list that is not in any plan ("dish soap").
model ShoppingExtra {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  amount    String?
  aisle     String?
  checked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

enum Slot {
  BREAKFAST
  SNACK_1
  LUNCH
  SNACK_2
  DINNER
}

enum EntryStatus {
  PLANNED
  EATEN
  SKIPPED
}

enum Units {
  METRIC
  IMPERIAL
}
